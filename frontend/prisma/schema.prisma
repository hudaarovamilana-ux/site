generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String
  passwordHash      String
  status            String?
  onboardingJson    Json?
  healthProfileJson Json?
  checklistJson     Json?
  aiAskUsed         Int      @default(0)
  aiTrustUsed       Int      @default(0)
  aiHealthUsed      Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EmailVerification {
  email           String   @id
  codeHash        String
  name            String
  expiresAt       DateTime
  attempts        Int      @default(0)
  lastSentAt      DateTime
  sendCount       Int      @default(1)
  sendWindowStart DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model PasswordReset {
  email           String   @id
  codeHash        String
  expiresAt       DateTime
  attempts        Int      @default(0)
  lastSentAt      DateTime
  sendCount       Int      @default(1)
  sendWindowStart DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([expiresAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
