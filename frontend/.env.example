# DeepSeek API (оценка здоровья, «Спросить», чат доверия)
DEEPSEEK_API_KEY=your_key_here

# Необязательно (по умолчанию deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# PostgreSQL (Railway Postgres → Variables → DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Секрет сессий (случайная строка ≥ 16 символов)
AUTH_SECRET=change-me-to-a-long-random-string

# Подтверждение email при регистрации:

# Вариант 1 — Resend: https://resend.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Женская консультация <onboarding@resend.dev>

# Секрет для хеширования кодов OTP (случайная строка на продакшене)
VERIFICATION_SECRET=random-long-string

# Публичные реквизиты исполнителя (видны на /legal/requisites)
# NEXT_PUBLIC_LEGAL_NAME=Иванова Анна Ивановна
# NEXT_PUBLIC_LEGAL_INN=123456789012
# NEXT_PUBLIC_LEGAL_EMAIL=hello@womenshealth.tech
# NEXT_PUBLIC_LEGAL_PHONE=+7 900 000-00-00
# NEXT_PUBLIC_SITE_URL=https://www.womenshealth.tech

# ЮKassa (личный кабинет → Настройки / Ключи API)
# YOOKASSA_SHOP_ID=123456
# YOOKASSA_SECRET_KEY=live_xxx
# Webhook URL в кабинете ЮKassa:
# https://www.womenshealth.tech/api/payments/webhook
# Событие: payment.succeeded

# Мой налог — авточеки самозанятого после оплаты
# Пароль от lknpd.nalog.ru (тот же, что от личного кабинета физлица)
# MOY_NALOG_INN=860412760635
# MOY_NALOG_PASSWORD=password
# MOY_NALOG_DEVICE_ID=stable-device-id

# PORT задаёт Railway автоматически
