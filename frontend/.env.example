# DeepSeek API (оценка здоровья, «Спросить», чат доверия)
DEEPSEEK_API_KEY=your_key_here

# Необязательно (по умолчанию deepseek-chat)
# DEEPSEEK_MODEL=deepseek-chat

# PostgreSQL (Railway Postgres → Variables → DATABASE_URL)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Секрет сессий (случайная строка ≥ 16 символов)
AUTH_SECRET=change-me-to-a-long-random-string

# Подтверждение email при регистрации:

# Вариант 1 — Resend: https://resend.com
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=Женская консультация <onboarding@resend.dev>

# Секрет для хеширования кодов OTP (случайная строка на продакшене)
VERIFICATION_SECRET=random-long-string

# PORT задаёт Railway автоматически
